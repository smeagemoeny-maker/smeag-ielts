{
  "regions": ["syd1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{data/**,uploads/**,.git/**,README.md}"
    }
  },
  "routes": [
    { "src": "/(data|db|includes|uploads|api)(/.*)?", "dest": "/api/index.php" },
    { "src": "/(.*)\\.php", "dest": "/api/index.php" },
    { "src": "/(.*/)?", "dest": "/api/index.php" },
    { "src": "/\\.(.*)", "status": 404 },
    { "src": "/(.*)/_engine/(.*)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
